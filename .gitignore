# --- Python virtual environment (each machine creates its own) ---
.venv/

# --- Python caches ---
__pycache__/
*.pyc

# --- Jupyter autosave checkpoints ---
.ipynb_checkpoints/

# --- Web app dependencies and build output (for later) ---
node_modules/
dist/

# --- Large simulation outputs ---
*.npy
*.npz
*.h5

# --- Personal editor and Claude Code settings ---
.vscode/
.claude/settings.local.json

# --- OS clutter ---
Thumbs.db
desktop.ini
.DS_Store
